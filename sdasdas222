function Components.Slider(parent, cfg, order)
    local min = cfg.Min or 0
    local max = cfg.Max or 100
    local decimals = cfg.Decimals or 0
    local suffix = cfg.Suffix or ""
    local default = cfg.Default or min

    if type(UI.State.Saved[cfg.Flag]) == "number" then
        default = UI.State.Saved[cfg.Flag]
    end

    local value = math.clamp(Util.Round(default, decimals), min, max)
    local root = Components.OptionRoot(parent, UI.Mobile and 38 or 32, order)

    local label = Util.Label({
        Text = cfg.Title or "Slider",
        TextSize = 12,
        ColorKey = "SubText",
        Size = UDim2.new(1, -60, 0, 14),
        Parent = root,
    })
    local valueLabel = Util.Label({
        Text = tostring(value) .. suffix,
        TextSize = 11,
        ColorKey = "Text",
        TextXAlignment = Enum.TextXAlignment.Right,
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, 0, 0, 0),
        Size = UDim2.fromOffset(60, 14),
        Parent = root,
    })

    local bar = Util.New("Frame", {
        AnchorPoint = Vector2.new(0, 1),
        Position = UDim2.new(0, 0, 1, -2),
        Size = UDim2.new(1, 0, 0, 5),
        BackgroundTransparency = 0.35,
        BorderSizePixel = 0,
        Parent = root,
    }, { Util.Corner(UDim.new(1, 0)), Util.Stroke("BorderSoft", 1, 0.24) })
    themeBind(bar, "BackgroundColor3", "SurfaceAlt")

    local fill = Util.New("Frame", {
        Size = UDim2.fromScale(0, 1),
        BorderSizePixel = 0,
        Parent = bar,
    }, {
        Util.Corner(UDim.new(1, 0)),
        Util.Gradient(function()
            return ColorSequence.new({
                ColorSequenceKeypoint.new(0, Palette.AccentDim),
                ColorSequenceKeypoint.new(0.5, Palette.AccentSoft),
                ColorSequenceKeypoint.new(1, Palette.Accent),
            })
        end),
    })
    themeBind(fill, "BackgroundColor3", "Accent")

    local knob = Util.New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.fromOffset(8, 9),
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = fill,
    }, { Util.Corner(UDim.new(1, 0)) })
    themeBind(knob, "BackgroundColor3", "AccentSoft")

    local hitArea = Util.New("TextButton", {
        Text = "",
        AutoButtonColor = false,
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(0, 1),
        Position = UDim2.new(0, 0, 1, 0),
        Size = UDim2.new(1, 0, 0, UI.Mobile and 32 or 16),
        Parent = root,
    })

    local self = {
        Type = "Slider",
        Value = value,
        Root = root,
        Set = function(_, v, silent, instant)
            v = math.clamp(Util.Round(tonumber(v) or min, decimals), min, max)
            self.Value = v
            UI.State.Flags[cfg.Flag] = v
            saveConfig()
            local pct = max > min and (v - min) / (max - min) or 0
            valueLabel.Text = tostring(v) .. suffix
            if instant then
                fill.Size = UDim2.fromScale(pct, 1)
            else
                Util.Tween(fill, { Size = UDim2.fromScale(pct, 1) }, 0.14)
            end
            if not silent and cfg.Callback then task.spawn(cfg.Callback, v) end
        end,
        Get = function() return self.Value end,
    }

    local dragging = false
    local function apply(pos)
        local absPos = bar.AbsolutePosition.X
        local absSize = bar.AbsoluteSize.X
        if absSize < 1 then return end
        local pct = math.clamp((pos.X - absPos) / absSize, 0, 1)
        self:Set(min + (max - min) * pct, false, true)
    end

    Util.Connect(hitArea.InputBegan, function(inp)
        if inp.UserInputType ~= Enum.UserInputType.MouseButton1 and inp.UserInputType ~= Enum.UserInputType.Touch then return end
        dragging = true
        apply(inp.Position)
    end)
    Util.Connect(UserInputService.InputChanged, function(inp)
        if not dragging then return end
        if inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch then
            apply(inp.Position)
        end
    end)
    Util.Connect(UserInputService.InputEnded, function(inp)
        if not dragging then return end
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            dragging = false
            saveConfig()
        end
    end)
    Util.Hover(hitArea,
        function() Util.Tween(label, { TextColor3 = Palette.Text }, 0.16) end,
        function() if not dragging then Util.Tween(label, { TextColor3 = Palette.SubText }, 0.2) end end
    )

    self:Set(value, true, true)
    if cfg.Callback then task.spawn(cfg.Callback, value) end
    return self
end

