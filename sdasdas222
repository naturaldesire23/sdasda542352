            AutomaticSize = Enum.AutomaticSize.Y,
            Size = UDim2.new(1, 0, 0, 0),
            Parent = body,
        })
    end

    local progressWrap = Util.New("Frame", {
        Size = UDim2.new(1, 0, 0, 11),
        BackgroundTransparency = 1,
        LayoutOrder = 9,
        Parent = body,
    })

    local progressBg = Util.New("Frame", {
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, 0, 1, 0),
        Size = UDim2.new(1, 0, 0, 3),
        BackgroundTransparency = 0.86,
        BorderSizePixel = 0,
        Parent = progressWrap,
    }, { Util.Corner(2) })
    themeBind(progressBg, "BackgroundColor3", "SubText")

    local progressFill = Util.New("Frame", {
        Size = UDim2.new(1, 0, 1, 0),
        BorderSizePixel = 0,
        Parent = progressBg,
    }, { Util.Corner(2) })
    themeBind(progressFill, "BackgroundColor3", info.key)

    local entry = { Card = card, Height = 64, Dismissing = false }
    table.insert(Notify.Active, 1, entry)

    local function measure()
        return card.AbsoluteSize.Y / math.max(notifyScale.Scale, 0.01)
    end

    entry.ResizeConn = card:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
        local h = measure()
        if math.abs(h - entry.Height) > 0.5 then
            entry.Height = h
            if not entry.Dismissing then Notify.Restack(true) end
        end
    end)

    card.Position = UDim2.new(profile.xs, profile.hidden, profile.ys, profile.sign * Notify.BaseOffset(profile))

    task.defer(function()
        if not card.Parent then return end
        entry.Height = math.max(measure(), 1)
        Notify.Restack(true)
        Util.Tween(card, { GroupTransparency = 0 }, 0.3)
        Util.Tween(progressFill, { Size = UDim2.new(0, 0, 1, 0) }, duration, Enum.EasingStyle.Linear)
    end)

    local function dismiss()
        if entry.Dismissing or not card.Parent then return end
        entry.Dismissing = true
        if entry.ResizeConn then entry.ResizeConn:Disconnect() end
        for i, c in ipairs(Notify.Active) do
            if c == entry then table.remove(Notify.Active, i) break end
        end
        Notify.Restack(true)
        local p = Notify.Profile()
        Util.Tween(card, { Position = UDim2.new(p.xs, p.hidden, card.Position.Y.Scale, card.Position.Y.Offset) }, 0.28, UI.Layout.Ease, UI.Layout.EaseIn)
        Util.Tween(card, { GroupTransparency = 1 }, 0.24, Enum.EasingStyle.Quad, UI.Layout.EaseIn)
        task.delay(0.3, function() card:Destroy() end)
    end

    entry.Dismiss = dismiss
    task.delay(duration, dismiss)
    return entry
end

