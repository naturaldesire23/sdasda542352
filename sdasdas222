local Module = {}
Module.__index = Module

local componentKeys = { "Toggle", "Slider", "Dropdown", "Keybind", "Input", "Button", "Colorpicker", "Paragraph", "Divider" }

function Module.Create(tab, cfg)
    local self = setmetatable({}, Module)
    self.Tab = tab
    self.Config = cfg
    self.Title = cfg.Title or "Module"
    self.Flag = cfg.Flag
    self.Toggleable = cfg.Toggleable ~= false and cfg.Flag ~= nil
    self.Enabled = false
    self.Expanded = false
    self.Order = 0
    self.Keyword = (self.Title .. " " .. (cfg.Description or "")):lower()

    local hasDesc = cfg.Description ~= nil and cfg.Description ~= ""
    local hasKeybind = self.Toggleable and cfg.Keybind ~= false and self.Flag and not UI.Mobile
    local hasBell = self.Toggleable and cfg.Notify == true and self.Flag
    local headerH = hasKeybind and 56 or 46
    local toggleY = hasKeybind and 56/2 or 23

    self.Side = (cfg.Side or "Left"):lower()
    self.Column = self.Side == "right" and tab.Right or tab.Left

    local frame = Util.New("Frame", {
        Name = "Module",
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 0.15,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        LayoutOrder = #self.Column:GetChildren(),
        Parent = self.Column,
    }, {
        Util.Corner(10),
        Util.List(0),
        Util.Stroke("Border", 1, 0.3),
    })
    themeBind(frame, "BackgroundColor3", "Surface")
    self.Frame = frame
    self.Stroke = frame:FindFirstChildOfClass("UIStroke")

    local header = Util.New("TextButton", {
        Name = "Header",
        Text = "",
        AutoButtonColor = false,
        Size = UDim2.new(1, 0, 0, headerH),
        BackgroundTransparency = 1,
        Parent = frame,
    })
    self.Header = header

    local title = Util.Label({
        Text = self.Title,
        TextSize = 13,
        Weight = Enum.FontWeight.SemiBold,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Position = UDim2.new(0, 13, 0, hasDesc and 10 or 0),
        Size = UDim2.new(1, -26, 0, hasDesc and 15 or headerH),
        Parent = header,
    })

    if hasDesc then
        Util.Label({
            Text = cfg.Description,
            TextSize = 11,
            ColorKey = "SubText",
            TextTruncate = Enum.TextTruncate.AtEnd,
            Position = UDim2.new(0, 13, 0, 28),
            Size = UDim2.new(1, -26, 0, 14),
            Parent = header,
        })
    end

    local body = Util.New("Frame", {
        Name = "Body",
        Size = UDim2.new(1, 0, 0, 0),
        BackgroundTransparency = 1,
        ClipsDescendants = true,
        LayoutOrder = 2,
        Parent = frame,
    })
    self.Body = body

    local content = Util.New("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Parent = body,
    }, { Util.Padding(10, 13, 13, 13), Util.List(9) })
    self.Content = content

    themeBind(Util.New("Frame", {
        Size = UDim2.new(1, -26, 0, 1),
        Position = UDim2.new(0, 13, 0, 0),
        BackgroundTransparency = 0.5,
        BorderSizePixel = 0,
        Parent = body,
    }), "BackgroundColor3", "Border")

    local uiList = content:FindFirstChildOfClass("UIListLayout")

    local function contentHeight()
        local scale = tab.Window.Scale.Scale
        if tab.Window.RootScale then
            scale *= tab.Window.RootScale.Scale
        end
        return uiList.AbsoluteContentSize.Y / math.max(scale, 0.01) + 23
    end

    function self:Resize(instant)
        if not self.Expanded then return end
        local h = contentHeight()
        if instant then
            body.Size = UDim2.new(1, 0, 0, h)
        else
            Util.Tween(body, { Size = UDim2.new(1, 0, 0, h) }, 0.3)
        end
    end

    Util.Connect(uiList:GetPropertyChangedSignal("AbsoluteContentSize"), function()
        self:Resize(false)
    end)

    function self:SetExpanded(expanded, instant)
        if #content:GetChildren() <= 2 then expanded = false end
        self.Expanded = expanded
        local h = expanded and contentHeight() or 0
        if instant then
            body.Size = UDim2.new(1, 0, 0, h)
        else
            Util.Tween(body, { Size = UDim2.new(1, 0, 0, h) }, 0.34)
        end
    end

    -- Toggle switch
    local switch, knob = nil, nil
    if self.Toggleable then
        local wrap = Util.New("Frame", {
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -13, 0, toggleY),
            Size = UDim2.fromOffset(0, 20),
            AutomaticSize = Enum.AutomaticSize.X,
            BackgroundTransparency = 1,
            Parent = header,
        }, { Util.FlexRow(9) })

        if hasBell then
            attachBell({ Parent = wrap, LayoutOrder = 1, Flag = self.Flag, Size = 13 })
        end

        switch = Util.New("Frame", {
            Size = UDim2.fromOffset(30, 18),
            BackgroundTransparency = 0.45,
            BorderSizePixel = 0,
            LayoutOrder = 2,
            Parent = wrap,
        }, { Util.Corner(UDim.new(1, 0)), Util.Stroke("Border", 1, 0.2) })
        themeBind(switch, "BackgroundColor3", "SurfaceAlt")

        knob = Util.New("Frame", {
            AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.new(0, 3, 0.5, 0),
            Size = UDim2.fromOffset(12, 12),
            BorderSizePixel = 0,
            Parent = switch,
        }, { Util.Corner(UDim.new(1, 0)) })
        themeBind(knob, "BackgroundColor3", "Muted")

        Util.Connect(Util.New("TextButton", {
            Text = "",
            AutoButtonColor = false,
            BackgroundTransparency = 1,
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.new(1, UI.Mobile and 20 or 12, 1, UI.Mobile and 20 or 12),
            Parent = switch,
        }).MouseButton1Click, function()
            self:SetEnabled(not self.Enabled)
        end)
    end

    function self:SetEnabled(enabled, silent, instant)
        enabled = enabled == true
        self.Enabled = enabled
        if self.Flag then
            UI.State.Flags[self.Flag] = enabled
            saveConfig()
        end
        if switch then
            Util.Tween(switch, {
                BackgroundColor3 = enabled and Palette.Accent or Palette.SurfaceAlt,
                BackgroundTransparency = enabled and 0.05 or 0.45,
            }, instant and 0 or 0.26)
            Util.Tween(knob, {
                Position = enabled and UDim2.new(1, -15, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
                BackgroundColor3 = enabled and Palette.Background or Palette.Muted,
            }, instant and 0 or 0.32)
        end
        Util.Tween(self.Stroke, {
            Color = enabled and Palette.Accent or Palette.Border,
            Transparency = enabled and 0.5 or 0.3,
        }, 0.3)
        Util.Tween(title, { TextColor3 = (enabled or not self.Toggleable) and Palette.Text or Palette.SubText }, 0.26)
        if self.Toggleable then
            self:SetExpanded(true, instant)
        end
        if not silent and cfg.Callback then task.spawn(cfg.Callback, enabled) end
    end
    function self:Get() return self.Enabled end

    if hasKeybind then
        attachKeybind({
            Parent = header, Host = header,
            AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.new(0, 13, 0, 40),
            Flag = self.Flag, Label = self.Title, MaxWidth = 84,
            OnPress = function() self:SetEnabled(not self.Enabled) end,
        })
    end

    Util.Connect(header.MouseButton1Click, function()
        if not self.Toggleable then return end
        self:SetEnabled(not self.Enabled)
    end)

    Util.Hover(header,
        function()
            if not self.Enabled then
                Util.Tween(self.Stroke, { Color = Palette.Muted, Transparency = 0.55 }, 0.16)
            end
            Util.Tween(title, { TextColor3 = Palette.Text }, 0.18)
        end,
        function()
            if not self.Enabled then
                Util.Tween(self.Stroke, { Color = Palette.Border, Transparency = 0.3 }, 0.22)
                if self.Toggleable then
                    Util.Tween(title, { TextColor3 = Palette.SubText }, 0.22)
                end
            end
        end
    )

    self:SetEnabled(UI.State.Saved[self.Flag] == true, true, true)
    if self.Enabled and cfg.Callback then task.spawn(cfg.Callback, true) end

    table.insert(tab.Modules, self)
    return self
end

