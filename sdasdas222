    Util.Connect(UserInputService.InputChanged, function(inp)
        if not svDragging then return end
        if inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch then
            local sz = svBox.AbsoluteSize
            local pos = svBox.AbsolutePosition
            s = math.clamp((inp.Position.X - pos.X) / math.max(sz.X, 1), 0, 1)
            v = 1 - math.clamp((inp.Position.Y - pos.Y) / math.max(sz.Y, 1), 0, 1)
            update()
        end
    end)
    Util.Connect(UserInputService.InputEnded, function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            svDragging = false
        end
    end)

    -- Hue drag
    local hueDragging = false
    Util.Connect(hueBar.InputBegan, function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            hueDragging = true
        end
    end)
    Util.Connect(UserInputService.InputChanged, function(inp)
        if not hueDragging then return end
        if inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch then
            local sz = hueBar.AbsoluteSize
            local pos = hueBar.AbsolutePosition
            h = math.clamp((inp.Position.X - pos.X) / math.max(sz.X, 1), 0, 1)
            update()
        end
    end)
    Util.Connect(UserInputService.InputEnded, function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            hueDragging = false
        end
    end)

    Util.Connect(hexBox.FocusLost, function()
        local raw = hexBox.Text:gsub("#", "")
        if #raw == 6 and tonumber(raw, 16) then
            self:Set(Color3.fromHex(raw))
        else
            update(true)
        end
    end)

    Util.Hover(header,
        function() Util.Tween(headerLabel, { TextColor3 = Palette.Text }, 0.16) end,
        function() Util.Tween(headerLabel, { TextColor3 = Palette.SubText }, 0.2) end
    )

    update(true)
    if cfg.Callback then task.spawn(cfg.Callback, self.Value) end
    return self
end

