        ZIndex = 2,
        Parent = tabScroll,
    }, { Util.List(UI.Layout.TabGap), Util.Padding(UI.Layout.TabPad, 0, UI.Layout.TabPad, UI.Layout.TabPad) })

    -- Content area
    local content = Util.New("Frame", {
        Name = "Content",
        Position = UDim2.new(0, UI.Layout.SidebarW + 1, 0, UI.Layout.TopbarH + 1),
        Size = UDim2.new(1, -(UI.Layout.SidebarW + 1), 1, -(UI.Layout.TopbarH + 1)),
        BackgroundTransparency = 1,
        ZIndex = 4,
        Parent = root,
    })
    win.Content = content

    local page, _, left, right = Page.Create(content)
    win.Layer = page
    win.Left = left
    win.Right = right

    local noResults = Util.Label({
        Text = "No modules found",
        TextSize = 12,
        ColorKey = "Muted",
        TextXAlignment = Enum.TextXAlignment.Center,
        Position = UDim2.fromScale(0, 0.32),
        Size = UDim2.new(1, 0, 0, 16),
        Visible = false,
        Parent = page,
    })

    Util.Connect(searchBox:GetPropertyChangedSignal("Text"), function()
        local query = searchBox.Text:lower():gsub("^%s+", ""):gsub("%s+$", "")
        local searching = query ~= ""
        local order = 0
        for _, t in ipairs(win.Tabs) do
            for _, m in ipairs(t.Modules) do
                local match = searching and m.Keyword:find(query, 1, true) ~= nil
                local col = m.Column
                if match then
                    order = order + 1
                    m.Frame.LayoutOrder = order
                    col = order % 2 == 1 and left or right
                else
                    m.Frame.LayoutOrder = m.Frame.LayoutOrder
                end
                if m.Frame.Parent ~= col then
                    m.Frame.Parent = col
                end
            end
        end
        noResults.Visible = searching and order == 0
        if searching then
            if win.ActiveTab then win.ActiveTab.Page.Visible = false end
            page.Visible = true
            page.GroupTransparency = 0
        else
            page.Visible = false
            if win.ActiveTab then
                win.ActiveTab.Page.Visible = true
                win.ActiveTab.Page.GroupTransparency = 0
            end
        end
    end)

    -- Dragging
    local dragging, dragStart, startPos = false, nil, nil
    Util.Connect(topbar.InputBegan, function(inp)
        if win.BlockDrag then return end
        if inp.UserInputType ~= Enum.UserInputType.MouseButton1 and inp.UserInputType ~= Enum.UserInputType.Touch then return end
        dragging = true
        dragStart = inp.Position
        startPos = holder.Position
    end)
    Util.Connect(UserInputService.InputChanged, function(inp)
        if not dragging then return end
        if inp.UserInputType ~= Enum.UserInputType.MouseMovement and inp.UserInputType ~= Enum.UserInputType.Touch then return end
        local delta = inp.Position - dragStart
        holder.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X / uiScale.Scale,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y / uiScale.Scale
        )
    end)
    Util.Connect(UserInputService.InputEnded, function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    -- Open/close
    local openTweens = {}
    function win:SetVisible(visible, instant)
        self.Open = visible == true
        for _, t in ipairs(openTweens) do t:Cancel() end
        openTweens = {}
        if self.Open then
            holder.Visible = true
            shadow.Visible = true
            holder.Size = UDim2.fromOffset(UI.Layout.Width, UI.Layout.Height)
            shadow.Size = UDim2.new(1, 97, 1, 111)
            self.RootScale.Scale = 0.78
            root.GroupTransparency = 1
            shadow.ImageTransparency = 1
            if instant then
                self.RootScale.Scale = 0.94
                root.GroupTransparency = 0
                shadow.ImageTransparency = 0.45
            else
                table.insert(openTweens, Util.Tween(self.RootScale, { Scale = 0.94 }, 0.36))
                table.insert(openTweens, Util.Tween(root, { GroupTransparency = 0 }, 0.28))
                table.insert(openTweens, Util.Tween(shadow, { ImageTransparency = 0.45 }, 0.32))
            end
        else
            if instant then
                holder.Visible = false
                shadow.Visible = false
            else
                table.insert(openTweens, Util.Tween(self.RootScale, { Scale = 0.86 }, 0.22, UI.Layout.Ease, UI.Layout.EaseIn))
                table.insert(openTweens, Util.Tween(root, { GroupTransparency = 1 }, 0.2, UI.Layout.Ease, UI.Layout.EaseIn))
                table.insert(openTweens, Util.Tween(shadow, { ImageTransparency = 1 }, 0.2, UI.Layout.Ease, UI.Layout.EaseIn))
                task.delay(0.22, function()
                    if not self.Open then
                        holder.Visible = false
                        shadow.Visible = false
                        self.RootScale.Scale = 0.94
                    end
                end)
            end
        end
    end

    function win:Toggle()
        self:SetVisible(not self.Open)
    end

    function win:Destroy()
        for _, c in ipairs(UI.State.Connections) do pcall(function() c:Disconnect() end) end
        table.clear(UI.State.Connections)
        table.clear(UI.State.ThemeBindings)
        saveConfig()
        pcall(function() screen:Destroy() end)
        if notifyFrame then pcall(function() notifyFrame:Destroy() end) end
    end

    function win:Tab(tabCfg)
        return Tab.Create(self, tabCfg)
    end

    function win:Notify(arg)
        return Notify.Push(arg)
    end

    Util.Connect(minimizeBtn.MouseButton1Click, function()
        win:Toggle()
    end)

    Util.Connect(UserInputService.InputBegan, function(inp, gp)
        if gp or Bind.Binding then return end
        if inp.KeyCode == self.ToggleKey then
            win:Toggle()
        end
    end)

    -- Notifications mount
    Notify.Mount(screen, uiScale.Scale)

    table.insert(UI.State.Windows, win)
    task.defer(function() win:SetVisible(true) end)
    return win
end

UI.Window = Window.Open

-- Notify is both callable and has methods
local notifyCallable = setmetatable({}, {
    __call = function(_, arg) return Notify.Push(arg) end,
    __index = function(_, key)
        if key == "SetPosition" then return Notify.SetPosition end
        if key == "GetPosition" then return function() return Notify.Position end end
        return nil
    end,
})
UI.Notify = notifyCallable

