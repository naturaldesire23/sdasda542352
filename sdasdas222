--============================================================
-- Config
--============================================================

local ConfigFolder = nil
local ConfigName = nil

local function hasFilesystem()
    return typeof(writefile) == "function"
        and typeof(readfile) == "function"
        and typeof(isfile) == "function"
        and typeof(isfolder) == "function"
        and typeof(makefolder) == "function"
end

local function encodeValue(v)
    if typeof(v) == "Color3" then
        return { __t = "Color3", r = math.floor(v.R*255+0.5), g = math.floor(v.G*255+0.5), b = math.floor(v.B*255+0.5) }
    end
    if typeof(v) == "EnumItem" then
        return { __t = "Enum", v = tostring(v) }
    end
    return v
end

local function decodeValue(v)
    if type(v) == "table" and v.__t == "Color3" then
        return Color3.fromRGB(v.r, v.g, v.b)
    end
    if type(v) == "table" and v.__t == "Enum" then
        local a, b = v.v:match("^Enum%.(%w+)%.(%w+)$")
        if a and Enum[a] then
            local ok, r = pcall(function() return Enum[a][b] end)
            if ok then return r end
        end
        return nil
    end
    return v
end

local function configPath()
    return ConfigFolder .. "/" .. ConfigName .. ".json"
end

local saveQueued = false
local function saveConfig()
    if not hasFilesystem() or not ConfigFolder or not ConfigName then return end
    if saveQueued then return end
    saveQueued = true
    task.delay(0.4, function()
        saveQueued = false
        local out = {}
        for k, v in pairs(UI.State.Flags) do
            out[k] = encodeValue(v)
        end
        pcall(function()
            writefile(configPath(), HttpService:JSONEncode(out))
        end)
    end)
end

local function loadConfig()
    if not hasFilesystem() or not ConfigFolder or not ConfigName then return {} end
    if not isfile(configPath()) then return {} end
    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile(configPath()))
    end)
    if not ok or type(data) ~= "table" then return {} end
    local out = {}
    for k, v in pairs(data) do
        out[k] = decodeValue(v)
    end
    return out
end

local function setupConfig(folder, name)
    ConfigFolder = folder or "ZenthraUI"
    ConfigName = name or "config"
    if not hasFilesystem() then return end
    if not isfolder(ConfigFolder) then
        pcall(makefolder, ConfigFolder)
    end
    UI.State.Saved = loadConfig()
    for k, v in pairs(UI.State.Saved) do
        UI.State.Flags[k] = v
    end
end

--============================================================
-- Theme system
--============================================================

local function themeBind(inst, prop, key)
    table.insert(UI.State.ThemeBindings, { instance = inst, property = prop, key = key })
    inst[prop] = Palette[key]
    return inst
end

local function themeBindDynamic(inst, prop, resolve)
    table.insert(UI.State.ThemeBindings, { instance = inst, property = prop, resolve = resolve })
    inst[prop] = resolve()
    return inst
end

local function themeSet(newTheme)
    newTheme = newTheme or {}
    for k, v in pairs(newTheme) do
        if Palette[k] ~= nil and typeof(v) == "Color3" then
            Palette[k] = v
        end
    end
    for i = #UI.State.ThemeBindings, 1, -1 do
        local b = UI.State.ThemeBindings[i]
        if not pcall(function()
            b.instance[b.property] = b.resolve and b.resolve() or Palette[b.key]
        end) then
            table.remove(UI.State.ThemeBindings, i)
        end
    end
end

local function themeSetAccent(color)
    themeSet({
        Accent = color,
        AccentSoft = color:Lerp(Color3.new(1,1,1), 0.28),
    })
end

local function themeReset()
    themeSet(DefaultPalette)
end

UI.SetTheme = themeSet
UI.SetAccent = themeSetAccent
UI.ResetTheme = themeReset
UI.GetFlag = function(k) return UI.State.Flags[k] end
UI.SetFlag = function(k, v) UI.State.Flags[k] = v; saveConfig() end

--============================================================
-- Util primitives
--============================================================

local Util = {}

function Util.New(class, props, children)
    local inst = Instance.new(class)
    local parent
    if props then
        parent = props.Parent
        props.Parent = nil
        for k, v in pairs(props) do
            inst[k] = v
        end
    end
    if children then
        for _, c in ipairs(children) do
            c.Parent = inst
        end
    end
    inst.Parent = parent
    return inst
end

function Util.Font(weight)
    weight = weight or Enum.FontWeight.Medium
    local cached = UI.State.FontCache[weight]
    if not cached then
        cached = Font.new(UI.Layout.FontFamily, weight)
        UI.State.FontCache[weight] = cached
    end
    return cached
end

function Util.Connect(signal, fn)
    local c = signal:Connect(fn)
    table.insert(UI.State.Connections, c)
    return c
end

function Util.Tween(inst, props, time, ease, dir)
    local t = TweenService:Create(
        inst,
        TweenInfo.new(
            time or 0.22,
            ease or UI.Layout.Ease,
            dir or Enum.EasingDirection.Out
        ),
        props
    )
    t:Play()
    return t
end

function Util.Corner(radius)
    local r = typeof(radius) == "UDim" and radius or UDim.new(0, radius or 8)
    return Util.New("UICorner", { CornerRadius = r })
end

function Util.Stroke(colorKey, thickness, transparency)
    local s = Util.New("UIStroke", {
        Thickness = thickness or 1,
        Transparency = transparency or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    })
    themeBind(s, "Color", colorKey or "Border")
    return s
end

function Util.Gradient(colorFn, transparency, rotation)
    local g = Util.New("UIGradient", {
        Transparency = transparency or NumberSequence.new(0),
        Rotation = rotation or 0,
    })
    if colorFn then
        themeBindDynamic(g, "Color", colorFn)
    end
    return g
end

function Util.Fade(...)
    local args = { ... }
    local points = {}
    local n = #args
    for i, v in ipairs(args) do
        points[i] = NumberSequenceKeypoint.new((i - 1) / (n - 1), v)
    end
    return NumberSequence.new(points)
end

function Util.Padding(t, b, l, r)
    return Util.New("UIPadding", {
        PaddingTop = UDim.new(0, t or 0),
        PaddingBottom = UDim.new(0, b or t or 0),
        PaddingLeft = UDim.new(0, l or 0),
        PaddingRight = UDim.new(0, r or l or 0),
    })
end

function Util.List(gap, align)
    return Util.New("UIListLayout", {
        Padding = UDim.new(0, gap or 0),
        SortOrder = Enum.SortOrder.LayoutOrder,
        HorizontalAlignment = align or Enum.HorizontalAlignment.Left,
    })
end

function Util.FlexRow(gap)
    return Util.New("UIListLayout", {
        Padding = UDim.new(0, gap or 6),
        FillDirection = Enum.FillDirection.Horizontal,
        VerticalAlignment = Enum.VerticalAlignment.Center,
        SortOrder = Enum.SortOrder.LayoutOrder,
    })
end

function Util.Grow()
    return Util.New("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill })
end

function Util.Label(props, children)
    local weight = props.Weight
    local colorKey = props.ColorKey
    props.Weight = nil
    props.ColorKey = nil
    if props.BackgroundTransparency == nil then props.BackgroundTransparency = 1 end
    props.FontFace = Util.Font(weight or Enum.FontWeight.Medium)
    props.TextSize = props.TextSize or 12
    props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
    props.AutoLocalize = false
    local lbl = Util.New("TextLabel", props, children)
    themeBind(lbl, "TextColor3", colorKey or "Text")
    return lbl
end

function Util.Image(props, children)
    local colorKey = props.ColorKey
    props.ColorKey = nil
    if props.BackgroundTransparency == nil then props.BackgroundTransparency = 1 end
    props.ScaleType = props.ScaleType or Enum.ScaleType.Fit
    local img = Util.New("ImageLabel", props, children)
    if colorKey then
        themeBind(img, "ImageColor3", colorKey)
    end
    return img
end

function Util.Hover(inst, onEnter, onLeave)
    Util.Connect(inst.MouseEnter, onEnter)
    Util.Connect(inst.MouseLeave, onLeave)
end

function Util.Press(inst, scaleInst)
    if not scaleInst then return end
    Util.Connect(inst.MouseButton1Down, function()
        Util.Tween(scaleInst, { Scale = 0.94 }, 0.09)
    end)
    Util.Connect(inst.MouseButton1Up, function()
        Util.Tween(scaleInst, { Scale = 1 }, 0.28, Enum.EasingStyle.Back)
    end)
    Util.Connect(inst.MouseLeave, function()
        Util.Tween(scaleInst, { Scale = 1 }, 0.2)
    end)
end

function Util.Round(n, decimals)
    local m = 10 ^ (decimals or 0)
    return math.floor(n * m + 0.5) / m
end

function Util.KeyName(enumItem)
    if typeof(enumItem) == "EnumItem" then
        return (tostring(enumItem):gsub("Enum.KeyCode.", ""):gsub("Enum.UserInputType.", ""))
    end
    return "None"
end

function Util.ToKeyCode(v)
    if typeof(v) == "EnumItem" then return v end
    if type(v) ~= "string" then return nil end
    local ok, r = pcall(function() return Enum.KeyCode[v] end)
    return ok and r or nil
end

UI.Util = Util

--============================================================
-- Bind system (keybind chips + bells)
--============================================================

local Bind = {}
Bind.Changed = function() end
local bindListeners = {}
function Bind.OnChanged(fn)
    table.insert(bindListeners, fn)
end
function Bind.FireChanged()
    for _, fn in ipairs(bindListeners) do
        pcall(fn)
    end
end
Bind.Binding = false

local function attachKeybind(cfg)
    if UI.Mobile or not cfg.Flag then return nil end
    local keyFlag = cfg.Flag .. "__key"
    local keyCode = Util.ToKeyCode(UI.State.Saved[keyFlag])

    local btn = Util.New("TextButton", {
        Name = "Keybind",
        Text = "",
        AutoButtonColor = false,
        AnchorPoint = cfg.LayoutOrder and Vector2.new(0,0) or cfg.AnchorPoint or Vector2.new(1, 0.5),
        Position = cfg.Position or UDim2.new(),
        LayoutOrder = cfg.LayoutOrder or 0,
        Size = UDim2.fromOffset(0, UI.Layout.ChipH),
        AutomaticSize = Enum.AutomaticSize.X,
        BackgroundTransparency = 0.4,
        BorderSizePixel = 0,
        Parent = cfg.Parent,
    }, {
        Util.Corner(4),
        Util.Padding(0, 0, 6, 6),
        Util.New("UISizeConstraint", { MaxSize = Vector2.new(cfg.MaxWidth or 60, UI.Layout.ChipH) }),
    })
    themeBind(btn, "BackgroundColor3", "SurfaceAlt")

    local stroke = Util.Stroke("Border", 1, 0.25)
    stroke.Parent = btn

    local lbl = Util.Label({
        Text = "-",
        TextSize = 10,
        Weight = Enum.FontWeight.SemiBold,
        ColorKey = "SubText",
        TextXAlignment = Enum.TextXAlignment.Center,
        AutomaticSize = Enum.AutomaticSize.X,
        Size = UDim2.fromOffset(0, UI.Layout.ChipH),
        Parent = btn,
    })

    local bind = { Flag = cfg.Flag, Label = cfg.Label or "Bind", Key = keyCode }
    table.insert(UI.State.Binds, bind)

    local binding = false
    local function refresh()
        lbl.Text = binding and "?" or (keyCode and Util.KeyName(keyCode) or "-")
        lbl.TextColor3 = (binding or keyCode) and Palette.Text or Palette.Muted
        Util.Tween(stroke, {
            Color = binding and Palette.Accent or Palette.Border,
            Transparency = binding and 0.3 or 0.25,
        }, 0.18)
        bind.Key = keyCode
        Bind.FireChanged()
    end
    refresh()

    local function startBind()
        if Bind.Binding then return end
        Bind.Binding = true
        binding = true
        refresh()
        local conn
        local function onInput(inp)
            if inp.UserInputType ~= Enum.UserInputType.Keyboard then return end
            if inp.KeyCode == Enum.KeyCode.Unknown then return end
            conn:Disconnect()
            binding = false
            if inp.KeyCode == Enum.KeyCode.Backspace or inp.KeyCode == Enum.KeyCode.Escape then
                keyCode = nil
            else
                keyCode = inp.KeyCode
            end
            UI.State.Flags[keyFlag] = keyCode
            saveConfig()
            refresh()
            task.defer(function() Bind.Binding = false end)
        end
        conn = UserInputService.InputBegan:Connect(onInput)
    end

    Util.Connect(btn.InputBegan, function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.MouseButton2 then
            startBind()
        end
    end)

    if cfg.Host then
        Util.Connect(cfg.Host.InputBegan, function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton2 then
                startBind()
            end
        end)
    end

    Util.Connect(UserInputService.InputBegan, function(inp, gp)
        if gp or Bind.Binding or not keyCode then return end
        if inp.KeyCode == keyCode and cfg.OnPress then
            task.spawn(cfg.OnPress)
        end
    end)

    Util.Hover(btn,
        function() Util.Tween(btn, { BackgroundTransparency = 0.1 }, 0.16) end,
        function() Util.Tween(btn, { BackgroundTransparency = 0.4 }, 0.2) end
    )

    return { Chip = btn, Get = function() return keyCode end }
end

local function attachBell(cfg)
    local flag = cfg.Flag .. "__notify"
    local on = UI.State.Saved[flag] == true
    local size = cfg.Size or 13

    local img = Util.New("ImageLabel", {
        Name = "Bell",
        Image = "rbxassetid://10709811023",
        ScaleType = Enum.ScaleType.Fit,
        AnchorPoint = cfg.LayoutOrder and Vector2.new(0,0) or Vector2.new(1, 0.5),
        Position = cfg.Position or UDim2.new(),
        LayoutOrder = cfg.LayoutOrder or 0,
        Size = UDim2.fromOffset(size, size),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Parent = cfg.Parent,
    })
    themeBindDynamic(img, "ImageColor3", function()
        return on and Palette.Accent or Palette.SubText
    end)
    img.ImageTransparency = on and 0.05 or 0.5

    Util.Connect(img.MouseButton1Click, function()
        on = not on
        UI.State.Flags[flag] = on
        saveConfig()
        Util.Tween(img, {
            ImageColor3 = on and Palette.Accent or Palette.SubText,
            ImageTransparency = on and 0.05 or 0.5,
        }, 0.26)
    end)

    return {
        Bell = img,
        IsOn = function() return on end,
        Announce = function(title, value)
            if not on then return end
            local isBool = type(value) == "boolean"
            UI:Notify({
                Title = title,
                Text = isBool and (value and "Enabled" or "Disabled") or tostring(value),
                Type = isBool and (value and "success" or "info") or "info",
                Duration = 2.5,
            })
        end,
    }
end

--============================================================
-- Component: Toggle
--============================================================

local Components = {}

function Components.OptionRoot(parent, height, order)
    return Util.New("Frame", {
        Name = "Option",
        Size = UDim2.new(1, 0, 0, height),
        BackgroundTransparency = 1,
        LayoutOrder = order,
        Parent = parent,
    })
end

function Components.Toggle(parent, cfg, order)
    local on = cfg.Default == true
    if UI.State.Saved[cfg.Flag] ~= nil then
        on = UI.State.Saved[cfg.Flag] == true
    end

    local root = Components.OptionRoot(parent, UI.Layout.Row, order)
    local btn = Util.New("TextButton", {
        Text = "",
        AutoButtonColor = false,
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Parent = root,
    }, { Util.FlexRow(7) })

    local label = Util.Label({
        Text = cfg.Title or "Toggle",
        TextSize = 12,
        ColorKey = "SubText",
        TextTruncate = Enum.TextTruncate.AtEnd,
        Size = UDim2.new(1, 0, 1, 0),
        LayoutOrder = 1,
        Parent = btn,
    }, { Util.Grow() })

    local self = { Type = "Toggle", Value = on, Root = root }

    if cfg.Keybind ~= false and cfg.Flag then
        attachKeybind({
            Parent = btn, Host = btn, LayoutOrder = 2,
            Flag = cfg.Flag, Label = cfg.Title or "Toggle", MaxWidth = 54,
            OnPress = function() self:Set(not self.Value) end,
        })
    end

    local bell = nil
    if cfg.Notify and cfg.Flag then
        bell = attachBell({ Parent = btn, LayoutOrder = 3, Flag = cfg.Flag })
    end

    local track = Util.New("Frame", {
        Size = UDim2.fromOffset(30, 16),
        BackgroundTransparency = 0.5,
        BorderSizePixel = 0,
        LayoutOrder = 4,
        Parent = btn,
    }, { Util.Corner(UDim.new(1, 0)), Util.Stroke("Border", 1, 0.2) })
    themeBind(track, "BackgroundColor3", "SurfaceAlt")

    local knob = Util.New("Frame", {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 3, 0.5, 0),
        Size = UDim2.fromOffset(10, 10),
        BorderSizePixel = 0,
        Parent = track,
    }, { Util.Corner(UDim.new(1, 0)) })
    themeBind(knob, "BackgroundColor3", "Muted")

    function self:Set(v, silent)
        v = v == true
        self.Value = v
        UI.State.Flags[cfg.Flag] = v
        saveConfig()

        Util.Tween(track, {
            BackgroundColor3 = v and Palette.Accent or Palette.SurfaceAlt,
            BackgroundTransparency = v and 0.05 or 0.5,
        }, 0.24)
        Util.Tween(knob, {
            Position = v and UDim2.new(1, -13, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
            BackgroundColor3 = v and Palette.Background or Palette.Muted,
        }, 0.3)
        Util.Tween(label, { TextColor3 = v and Palette.Text or Palette.SubText }, 0.24)

        if not silent then
            if cfg.Callback then task.spawn(cfg.Callback, v) end
            if bell then bell.Announce(cfg.Title or "Toggle", v) end
        end
    end
    function self:Get() return self.Value end

    Util.Connect(btn.MouseButton1Click, function() self:Set(not self.Value) end)
    Util.Hover(btn,
        function() if not self.Value then Util.Tween(label, { TextColor3 = Palette.Text }, 0.16) end end,
        function() if not self.Value then Util.Tween(label, { TextColor3 = Palette.SubText }, 0.2) end end
    )

    self:Set(on, true)
    if on and cfg.Callback then task.spawn(cfg.Callback, on) end
    return self
end

