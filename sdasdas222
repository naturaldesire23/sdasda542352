    ["Left Top"]     = { ax = 0, ay = 0, xs = 0, ys = 0, shown = 18,  hidden = -310, sign = 1 },
}

Notify.Width = 292
Notify.Gap = 8
Notify.Edge = 18
Notify.Active = {}
Notify.Position = "Right Bottom"

local notifyFrame = nil
local notifyScale = nil

function Notify.Mount(parent, scale)
    notifyFrame = Util.New("Frame", {
        Name = "Notifications",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Parent = parent,
    })
    notifyScale = Util.New("UIScale", { Scale = scale or 1, Parent = notifyFrame })
end

function Notify.Profile()
    return notifyProfiles[Notify.Position] or notifyProfiles["Right Bottom"]
end

function Notify.BaseOffset(profile)
    if profile.sign > 0 then
        return Notify.Edge + GuiService:GetGuiInset().Y
    end
    return Notify.Edge
end

function Notify.Restack(animated)
    local profile = Notify.Profile()
    local y = Notify.BaseOffset(profile)
    for _, card in ipairs(Notify.Active) do
        if not card.Dismissing and card.Card.Parent then
            card.Card.AnchorPoint = Vector2.new(profile.ax, profile.ay)
            local target = UDim2.new(profile.xs, profile.shown, profile.ys, profile.sign * y)
            if animated then
                Util.Tween(card.Card, { Position = target }, 0.34)
            else
                card.Card.Position = target
            end
            y = y + card.Height + Notify.Gap
        end
    end
end

function Notify.SetPosition(pos)
    if not notifyProfiles[pos] then return false end
    Notify.Position = pos
    Notify.Restack(true)
    return true
end

