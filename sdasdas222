function Components.Dropdown(parent, cfg, order)
    local multi = cfg.Multi == true
    local options = cfg.Options or {}
    local maxVisible = cfg.MaxVisible or 6
    local value = multi and {} or nil

    if multi then
        for _, v in ipairs(cfg.Default or {}) do
            value[v] = true
        end
    else
        value = cfg.Default
    end
    if UI.State.Saved[cfg.Flag] ~= nil then
        value = UI.State.Saved[cfg.Flag]
    end

    local root = Util.New("Frame", {
        Name = "Option",
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        LayoutOrder = order,
        Parent = parent,
    }, { Util.List(4) })

    local header = Util.New("Frame", {
        Size = UDim2.new(1, 0, 0, 14),
        BackgroundTransparency = 1,
        Parent = root,
    }, { Util.FlexRow(6) })

    Util.Label({
        Text = cfg.Title or "Dropdown",
        TextSize = 12,
        ColorKey = "SubText",
        TextTruncate = Enum.TextTruncate.AtEnd,
        Size = UDim2.new(0, 0, 1, 0),
        LayoutOrder = 1,
        Parent = header,
    }, { Util.Grow() })

    local bell = nil
    if cfg.Notify and cfg.Flag then
        bell = attachBell({ Parent = header, LayoutOrder = 2, Flag = cfg.Flag })
    end

    local trigger = Util.New("TextButton", {
        Text = "",
        AutoButtonColor = false,
        Size = UDim2.new(1, 0, 0, UI.Layout.FieldH),
        BackgroundTransparency = 0.35,
        BorderSizePixel = 0,
        Parent = root,
    }, {
        Util.Corner(6),
        Util.Stroke("Border", 1, 0.25),
        Util.Padding(0, 0, 10, 10),
    })
    themeBind(trigger, "BackgroundColor3", "SurfaceAlt")
    local triggerStroke = trigger:FindFirstChildOfClass("UIStroke")

    local display = Util.Label({
        Text = "None",
        TextSize = 12,
        ColorKey = "Text",
        TextTruncate = Enum.TextTruncate.AtEnd,
        Size = UDim2.new(1, -18, 1, 0),
        Parent = trigger,
    })
    local arrow = Util.Image({
        Image = "rbxassetid://10709793294",
        Size = UDim2.fromOffset(12, 12),
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0),
        ColorKey = "Muted",
        Parent = trigger,
    })

    local listWrap = Util.New("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        BackgroundTransparency = 1,
        ClipsDescendants = true,
        Parent = root,
    })

    local scroll = Util.New("ScrollingFrame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 0.35,
        BorderSizePixel = 0,
        ScrollBarThickness = 2,
        ScrollBarImageTransparency = 0.4,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(),
        ScrollingDirection = Enum.ScrollingDirection.Y,
        Parent = listWrap,
    }, {
        Util.Corner(6),
        Util.Stroke("Border", 1, 0.25),
        Util.Padding(4, 4, 4, 4),
        Util.List(2),
    })
    themeBind(scroll, "BackgroundColor3", "SurfaceAlt")
    themeBind(scroll, "ScrollBarImageColor3", "Muted")

    local optionFrames = {}
    local expanded = false
    local self = { Type = "Dropdown", Value = value, Options = options, Root = root }

    local function isSelected(opt)
        if multi then return value[opt] == true end
        return value == opt
    end

    local function refresh()
        if multi then
            local sel = {}
            for _, opt in ipairs(self.Options) do
                if value[opt] then table.insert(sel, opt) end
            end
            display.Text = #sel > 0 and table.concat(sel, ", ") or "None"
            display.TextColor3 = #sel > 0 and Palette.Text or Palette.Muted
        else
            display.Text = value and tostring(value) or "None"
            display.TextColor3 = value and Palette.Text or Palette.Muted
        end
        for k, f in pairs(optionFrames) do
            local sel = isSelected(k)
            Util.Tween(f.text, { TextColor3 = sel and Palette.Text or Palette.SubText }, 0.16)
            Util.Tween(f.frame, { BackgroundTransparency = sel and 0.86 or 1 }, 0.16)
            Util.Tween(f.tick, { ImageTransparency = sel and 0 or 1 }, 0.16)
        end
    end

    local function listHeight()
        local n = math.min(#self.Options, maxVisible)
        if n == 0 then return 40 end
        return n * UI.Layout.OptionH + (n - 1) * 2 + 8
    end

    local function setExpanded(v)
        expanded = v
        Util.Tween(listWrap, { Size = UDim2.new(1, 0, 0, expanded and listHeight() or 0) }, 0.26)
        Util.Tween(arrow, { Rotation = expanded and 180 or 0 }, 0.24)
        Util.Tween(triggerStroke, {
            Color = expanded and Palette.Accent or Palette.Border,
            Transparency = expanded and 0.4 or 0.25,
        }, 0.22)
    end

    local function toggleOption(opt)
        if multi then
            local new = table.clone(self.Value)
            new[opt] = not new[opt] or nil
            self:Set(new)
        else
            self:Set(opt)
            setExpanded(false)
        end
    end

    function self:Set(v, silent)
        if multi then
            local normalized = {}
            if type(v) == "table" then
                if #v > 0 then
                    for _, o in ipairs(v) do normalized[o] = true end
                else
                    for k, o in pairs(v) do if o then normalized[k] = true end end
                end
            end
            self.Value = normalized
        else
            self.Value = v
        end
        UI.State.Flags[cfg.Flag] = self.Value
        saveConfig()
        refresh()
        if not silent then
            if cfg.Callback then task.spawn(cfg.Callback, self.Value) end
            if bell then bell.Announce(cfg.Title or "Dropdown", display.Text) end
        end
    end
    function self:Get() return self.Value end

    function self:SetOptions(newOptions)
        self.Options = newOptions or {}
        for _, f in pairs(optionFrames) do f.frame:Destroy() end
        optionFrames = {}
        for i, opt in ipairs(self.Options) do
            local row = Util.New("TextButton", {
                Text = "",
                AutoButtonColor = false,
                Size = UDim2.new(1, 0, 0, UI.Layout.OptionH),
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                LayoutOrder = i,
                Parent = scroll,
            }, {
                Util.Corner(5),
                Util.Padding(0, 0, 8, 8),
                Util.FlexRow(6),
            })
            themeBind(row, "BackgroundColor3", "Accent")

            local rowLabel = Util.Label({
                Text = tostring(opt),
                TextSize = 11.5,
                ColorKey = "SubText",
                TextTruncate = Enum.TextTruncate.AtEnd,
                Size = UDim2.new(0, 0, 1, 0),
                LayoutOrder = 1,
                Parent = row,
            }, { Util.Grow() })

            local tick = Util.Image({
                Image = "rbxassetid://10709792310",
                Size = UDim2.fromOffset(10, 11),
                ImageTransparency = 1,
                ColorKey = "Accent",
                LayoutOrder = 2,
                Parent = row,
            })

            optionFrames[opt] = { frame = row, text = rowLabel, tick = tick }

            Util.Connect(row.MouseButton1Click, function() toggleOption(opt) end)
            Util.Hover(row,
                function() if not isSelected(opt) then Util.Tween(row, { BackgroundTransparency = 0.93 }, 0.16) end end,
                function() if not isSelected(opt) then Util.Tween(row, { BackgroundTransparency = 1 }, 0.18) end end
            )
        end

        if multi then
            local normalized = {}
            for k, v in pairs(self.Value or {}) do
                if optionFrames[k] then normalized[k] = true end
            end
            self.Value = normalized
        elseif self.Value ~= nil and not optionFrames[self.Value] then
            self.Value = nil
        end
        refresh()
        if expanded then setExpanded(true) end
    end

    Util.Connect(trigger.MouseButton1Click, function() setExpanded(not expanded) end)
    Util.Hover(trigger,
        function() if not expanded then Util.Tween(triggerStroke, { Transparency = 0.05 }, 0.16) end end,
        function() if not expanded then Util.Tween(triggerStroke, { Transparency = 0.25 }, 0.2) end end
    )

    self:SetOptions(options)
    self:Set(self.Value, true)
    if cfg.Callback then task.spawn(cfg.Callback, self.Value) end
    return self
end

