local LocalPlayer = Players.LocalPlayer

local function getParent()
    if typeof(gethui) == "function" then
        local ok, hui = pcall(gethui)
        if ok and hui then return hui end
    end
    local ok, cg = pcall(function() return game:GetService("CoreGui") end)
    if ok and cg and pcall(function() return cg.Name end) then
        return cg
    end
    return LocalPlayer:WaitForChild("PlayerGui")
end

local function protectGui(gui)
    local fn = rawget(getgenv and getgenv() or {}, "protectgui")
    if type(fn) ~= "function" then
        local syn = rawget(getgenv and getgenv() or {}, "syn")
        fn = type(syn) == "table" and syn.protect_gui or nil
    end
    if type(fn) == "function" then
        pcall(fn, gui)
    end
end

local function randomName()
    local chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
    local len = math.random(9, 15)
    local out = {}
    for i = 1, len do
        local n = math.random(1, #chars)
        out[i] = chars:sub(n, n)
    end
    return table.concat(out)
end

