function Components.Keybind(parent, cfg, order)
    local default = cfg.Default
    if UI.State.Saved[cfg.Flag] ~= nil then
        default = UI.State.Saved[cfg.Flag]
    end

    local keyCode = Util.ToKeyCode(default)
    local root = Components.OptionRoot(parent, UI.Layout.Row, order)

    Util.Label({
        Text = cfg.Title or "Keybind",
        TextSize = 12,
        ColorKey = "SubText",
        Size = UDim2.new(1, -80, 1, 0),
        Parent = root,
    })

    local btn = Util.New("TextButton", {
        Text = "",
        AutoButtonColor = false,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.fromOffset(70, 20),
        BackgroundTransparency = 0.4,
        BorderSizePixel = 0,
        Parent = root,
    }, { Util.Corner(6), Util.Stroke("Border", 1, 0.25) })
    themeBind(btn, "BackgroundColor3", "SurfaceAlt")

    local lbl = Util.Label({
        Text = Util.KeyName(keyCode),
        TextSize = 11,
        ColorKey = keyCode and "Text" or "Muted",
        TextXAlignment = Enum.TextXAlignment.Center,
        Size = UDim2.fromScale(1, 1),
        Parent = btn,
    })

    local binding = false
    local self = { Type = "Keybind", Value = keyCode, Root = root }
    local bindEntry = { Flag = cfg.Flag, Label = cfg.Title or "Keybind", Key = keyCode }
    table.insert(UI.State.Binds, bindEntry)

    function self:Set(v, silent)
        self.Value = v
        lbl.Text = Util.KeyName(v)
        lbl.TextColor3 = v and Palette.Text or Palette.Muted
        UI.State.Flags[cfg.Flag] = v
        saveConfig()
        bindEntry.Key = v
        Bind.FireChanged()
        if not silent and cfg.Changed then task.spawn(cfg.Changed, v) end
    end
    function self:Get() return self.Value end

    Util.Connect(btn.MouseButton1Click, function()
        if binding then return end
        binding = true
        Bind.Binding = true
        lbl.Text = "..."
        lbl.TextColor3 = Palette.Accent
    end)
    Util.Connect(UserInputService.InputBegan, function(inp, gp)
        if binding then
            if inp.UserInputType == Enum.UserInputType.Keyboard then
                binding = false
                Bind.Binding = false
                if inp.KeyCode == Enum.KeyCode.Escape or inp.KeyCode == Enum.KeyCode.Backspace then
                    self:Set(nil)
                else
                    self:Set(inp.KeyCode)
                end
            end
            return
        end
        if gp or not self.Value then return end
        if inp.KeyCode == self.Value and cfg.Callback then task.spawn(cfg.Callback) end
    end)
    Util.Hover(btn,
        function() if not binding then Util.Tween(btn, { BackgroundTransparency = 0.15 }, 0.16) end end,
        function() Util.Tween(btn, { BackgroundTransparency = 0.4 }, 0.2) end
    )

    self:Set(keyCode, true)
    return self
end

