local Tab = {}

function Tab.IndicatorPosition(window, targetTab)
    local sorted = {}
    for _, t in ipairs(window.Tabs) do table.insert(sorted, t) end
    table.sort(sorted, function(a, b) return a.Button.LayoutOrder < b.Button.LayoutOrder end)

    local pad = UI.Layout.TabPad
    for _, t in ipairs(sorted) do
        if t == targetTab then
            return UDim2.fromOffset(UI.Layout.TabPad, pad)
        end
        pad = pad + UI.Layout.TabH + UI.Layout.TabGap
    end
    return UDim2.fromOffset(UI.Layout.TabPad, UI.Layout.TabPad)
end

function Tab.SlideIndicator(window, targetTab, animated)
    if not window.Indicator or not targetTab then return end
    local target = Tab.IndicatorPosition(window, targetTab)
    window.Indicator.Visible = true
    window.Indicator.Size = UDim2.new(1, -(UI.Layout.TabPad * 2), 0, UI.Layout.TabH)
    if window.IndicatorTween then
        window.IndicatorTween:Cancel()
        window.IndicatorTween = nil
    end
    if not animated then
        window.Indicator.Position = target
        return
    end
    window.IndicatorTween = Util.Tween(window.Indicator, { Position = target }, 0.22)
end

function Tab.Create(window, cfg)
    cfg = cfg or {}
    local self = {
        Window = window,
        Title = cfg.Title or "Tab",
        Modules = {},
        Internal = cfg.Internal == true,
    }

    local btn = Util.New("TextButton", {
        Name = "Tab",
        Text = "",
        AutoButtonColor = false,
        Size = UDim2.new(1, 0, 0, UI.Layout.TabH),
        BackgroundTransparency = 1,
        ZIndex = 2,
        LayoutOrder = self.Internal and 999 or (#window.Tabs + 1),
        Parent = window.TabHolder,
    })
    self.Button = btn

    local row = Util.New("Frame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Parent = btn,
    }, { Util.FlexRow(9), Util.Padding(0, 0, 12, 12) })

    local icon = nil
    if cfg.Icon then
        icon = Util.Image({
            Image = cfg.Icon,
            Size = UDim2.fromOffset(14, 15),
            ImageTransparency = 0.35,
            ColorKey = "SubText",
            LayoutOrder = 1,
            Parent = row,
        })
    end

    local title = Util.Label({
        Text = self.Title,
        TextSize = 12.5,
        Weight = Enum.FontWeight.Medium,
        ColorKey = "SubText",
        AutomaticSize = Enum.AutomaticSize.X,
        Size = UDim2.new(0, 0, 1, 0),
        LayoutOrder = 2,
        Parent = row,
    })

    local page, scroll, left, right = Page.Create(window.Content)
    self.Page = page
    self.Scroller = scroll
    self.Left = left
    self.Right = right
    self.Text = title
    self.Glyph = icon

    function self:Select(instant)
        if window.SearchBox and window.SearchBox.Text ~= "" then
            window.SearchBox.Text = ""
        end
        if window.ActiveTab == self then return end
        local prev = window.ActiveTab
        window.ActiveTab = self
        local animated = instant ~= true

        if prev then
            Util.Tween(prev.Page, { GroupTransparency = 1 }, animated and 0.16 or 0)
            task.delay(animated and 0.16 or 0, function()
                if window.ActiveTab ~= prev then
                    prev.Page.Visible = false
                end
            end)
            Util.Tween(prev.Text, { TextColor3 = Palette.SubText }, animated and 0.2 or 0)
            if prev.Glyph then
                Util.Tween(prev.Glyph, { ImageColor3 = Palette.SubText, ImageTransparency = 0.35 }, animated and 0.2 or 0)
            end
        end

        page.Visible = true
        if animated then
            page.GroupTransparency = 1
            page.Position = UDim2.fromOffset(0, 8)
            Util.Tween(page, { GroupTransparency = 0, Position = UDim2.fromOffset(0, 0) }, 0.24)
            Util.Tween(title, { TextColor3 = Palette.Text }, 0.22)
            if icon then
                Util.Tween(icon, { ImageColor3 = Palette.Accent, ImageTransparency = 0 }, 0.22)
            end
        else
            page.GroupTransparency = 0
            page.Position = UDim2.fromOffset(0, 0)
            title.TextColor3 = Palette.Text
            if icon then
                icon.ImageColor3 = Palette.Accent
                icon.ImageTransparency = 0
            end
        end

        Tab.SlideIndicator(window, self, animated and prev ~= nil)
    end

    function self:SyncIndicator(animated)
        if window.ActiveTab ~= self then return end
        Tab.SlideIndicator(window, self, animated == true)
    end

    function self:Module(modCfg)
        return Module.Create(self, modCfg or {})
    end

    Util.Connect(btn.MouseButton1Click, function() self:Select() end)
    Util.Hover(btn,
        function()
            if window.ActiveTab ~= self then
                Util.Tween(title, { TextColor3 = Palette.Text }, 0.16)
                if icon then Util.Tween(icon, { ImageTransparency = 0.1 }, 0.16) end
            end
        end,
        function()
            if window.ActiveTab ~= self then
                Util.Tween(title, { TextColor3 = Palette.SubText }, 0.2)
                if icon then Util.Tween(icon, { ImageTransparency = 0.35 }, 0.2) end
            end
        end
    )

    table.insert(window.Tabs, self)
    if not self.Internal and (window.ActiveTab == nil or window.ActiveTab.Internal) then
        self:Select(true)
    end
    return self
end

